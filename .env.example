# Twilio Verify API
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# Deployment
VERCEL_URL=https://toy-soldiers-project.vercel.app


# Supabase Configuration
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_SERVICE_KEY=your_service_key
SUPABASE_JWT_SECRET=your_jwt_secret

# Supabase Public Variables (safe for client bundles)
EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Supabase Storage Buckets
SUPABASE_STORAGE_AVATARS_BUCKET=avatars
SUPABASE_STORAGE_CONTENT_BUCKET=content
SUPABASE_STORAGE_STREAM_RECORDINGS_BUCKET=stream-recordings

